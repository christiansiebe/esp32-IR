choice ESPNOW_ROLE
    prompt "ESP-NOW firmware role"
    default ESPNOW_ROLE_RECEIVER

config ESPNOW_ROLE_SENDER
    bool "Sender (UART SML decoder and ESP-NOW value transport)"

config ESPNOW_ROLE_RECEIVER
    bool "Receiver (SML value transport and Wi-Fi dashboard)"

endchoice

config ESPNOW_SENDER_LIGHT_SLEEP
    bool "Sender: adaptive light sleep between SML telegram bursts"
    default y
    depends on ESPNOW_ROLE_SENDER
    help
        Let the sender park the CPU (light sleep) in the quiet gaps between
        SML telegram bursts. The window adapts to the shortest quiet interval
        the UART has shown and backs off when a sleep was too long. Light sleep
        stops the APB clock, so an actively receiving UART would lose bytes;
        the window is therefore only entered after the line has gone quiet.
        This also enables Wi-Fi modem sleep on the sender so the Wi-Fi driver
        releases its APB lock. Enabled by default: the sender ships as a single
        image. Verify on the bench that ESP-NOW broadcasts are still received
        while sleeping (see TODO.md); disable to fall back to DFS only.
