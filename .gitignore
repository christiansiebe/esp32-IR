# NOTE: .gitignore has NO inline comments. A "#" only starts a comment at the
# start of a line; a line like "foo # bar" is a pattern for a file literally
# named "foo # bar". Keep every comment on its own line.

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
# Host-side utilities compiled on Windows
*.exe

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
# Generated in the build directory
flasher_args.json
sdkconfig.old
sdkconfig
sdkconfig.*

# The shipped defaults file is a source file, not a generated sdkconfig.
!sdkconfig.defaults
# Target-specific defaults (sdkconfig.defaults.<target>) are source files too;
# IDF loads them automatically after sdkconfig.defaults (see tools/cmake/kconfig.cmake).
!sdkconfig.defaults.*

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
# General workspace files, can be from various tools
*.workspace
# Visual Studio Solution User Options
*.suo
# Visual Studio
*.sln.docstates
.ccache/

# Version string generated by CMake at configure time (git describe)
main/build_version.h
fleet/.api_key
fleet/fleet_state.json
fleet/fleet.log

# Sandbox-lokale Laufzeitdaten des remote-shell-Kanals (PIDs, Logs, Queue).
remote-shell/run/

# agent-server Conversation-/Event-Daten (dieses Repo ist auf dem Odroid der
# agent-workspace-Bind-Mount). Kein Quellcode -- wird lokal live beschrieben.
workspace/
# Sandbox-/Sub-Agent-Laufzeitdaten, die im Repo-Verzeichnis landen, wenn die SSD
# als Workspace-Fallback dient (Conversations, Logs). Nie Quellcode.
workspace-sd-fallback/
subagents/

# Agent-Memory der Sandbox (wird ueber remote-shell/memory/SHARED.md geteilt).
.openhands/memory/

# Sandbox-Agent-Skills: .agents ist ein Symlink auf /root/.agents (ausserhalb
# des Repos, per Themen-Split erzeugt). Nie committen.
.agents
# Lokale Sicherung des vollen AGENTS.md vor dem Themen-Split.
AGENTS.md.vor-themen-split

# Bench power-measurement logs written by tools/fnb48_read.py (-o file.csv).
# Measurement data, never source. The committed partition tables are
# re-included below; Firmware/** keeps its own re-include at the very end.
*.csv
*.cfn
!partitions.csv

# The Firmware/ tree is a deliberately committed release bundle (see AGENTS.md
# "Flash bundles"), so re-include it even though *.bin / flasher_args.json match
# the build-output rules above. Keep this re-include last.
!Firmware/**
